# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication secrets (generate separate random values, at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret"
AUTH_CODE_SECRET="replace-with-another-long-random-secret"

# Email delivery (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Visitorly <no-reply@your-verified-domain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Visitorly"

NODE_ENV="development"
