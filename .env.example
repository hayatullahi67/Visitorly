# Database (Neon PostgreSQL)
# Pooled connection for the running application
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Direct connection for Prisma schema changes and migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication secrets (generate separate random values, at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret"
AUTH_CODE_SECRET="replace-with-another-long-random-secret"

# Email delivery (EmailJS)
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="your_emailjs_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Visitorly"

NODE_ENV="development"
